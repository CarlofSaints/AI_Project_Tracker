// AI Project CRM — inventory of every Claude/AI project across GitHub + Vercel.
//
// Design notes:
//  * Organization is ONE table. "Client" vs "Customer" is a role held on a
//    Project, not a property of the org — so Snomaster is a single row that can
//    be an end customer under Atomic Marketing on one project and the client on
//    another.
//  * Capability flags (email / SharePoint / external data) are auto-detected on
//    sync and stored in *Auto. A nullable *Override lets Carl correct one
//    without the next sync stomping it. Effective value = override ?? auto.
//  * User + nullable owner FKs exist so GitHub OAuth can be added later without
//    a painful migration. Nothing reads them yet.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7 no longer accepts `url` here — the connection string for CLI
// commands lives in prisma.config.ts, and the runtime gets it via the adapter
// in src/lib/db.ts.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- enums

enum ProjectStage {
  DEVELOPMENT // in development
  LIVE_ITERATING // live but iterating
  HANDED_OVER // handed over completely
  ARCHIVED // dead / parked
}

enum StoreKind {
  BLOB
  POSTGRES
  REDIS
  EDGE_CONFIG
  OTHER
}

enum Capability {
  EMAIL
  SHAREPOINT
  EXTERNAL_DATA
}

enum SignalSource {
  ENV_KEY // inferred from a Vercel env var name
  DEPENDENCY // inferred from package.json
  MANUAL // Carl said so
}

enum GitOwnerType {
  USER // e.g. CarlofSaints
  ORGANIZATION // e.g. OuterJoinZA
}

enum NoteAuthor {
  CARL // typed into the UI by hand
  ASSISTANT // written by Claude on Carl's behalf
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
}

// Third parties we pay. OTHER carries its real name in CostLine.vendorLabel so
// a one-off supplier never needs a schema change to be billed.
enum Vendor {
  VERCEL
  GITHUB
  ANTHROPIC
  RESEND
  GOOGLE
  OTHER
}

// METERED costs are caused by a specific project and attributed to it.
// BASE_FEE costs (a Pro seat, a plan minimum) are caused by the business, not a
// project — they are split across CLIENTS by hand, see SharedCostAllocation.
enum CostKind {
  METERED
  BASE_FEE
}

enum IngestStatus {
  RUNNING
  SUCCESS
  PARTIAL // some vendors succeeded, some failed
  FAILED
}

// ---------------------------------------------------------------- core

model Organization {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  notes     String?
  website   String?
  // Optional default agency relationship — only used to pre-fill the project
  // form. The project's own clientId/endCustomerId are the source of truth.
  parentId  String?
  parent    Organization?  @relation("OrgHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Organization[] @relation("OrgHierarchy")

  projectsAsClient      Project[] @relation("ProjectClient")
  projectsAsEndCustomer Project[] @relation("ProjectEndCustomer")

  // Uplift applied to this client's third-party costs, in basis points
  // (1500 = 15%). Null inherits BillingSettings.defaultMarkupBasisPoints, so
  // changing the house rate moves every client that hasn't been given its own.
  markupBasisPoints Int?

  sharedCostAllocations SharedCostAllocation[]
  periodTerms           ClientPeriodTerms[]

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

model Project {
  id   String @id @default(cuid())
  // Display name — defaults to the Vercel project or repo name, editable.
  name String

  // -- Vercel -----------------------------------------------------
  vercelProjectId   String? @unique
  vercelProjectName String?
  vercelScopeSlug   String? // carl-dos-santos-projects | outerjoin-d44b79be
  vercelScopeName   String? // "Carl Dos Santos' projects" | "OUTERJOIN"
  productionUrl     String?

  // -- Git --------------------------------------------------------
  gitOwner      String? // CarlofSaints | OuterJoinZA
  gitOwnerType  GitOwnerType?
  gitRepo       String?
  gitUrl        String?
  gitPrivate    Boolean?      @default(true)
  gitPushedAt   DateTime? // freshness — better "is this alive" signal than Vercel
  gitOpenIssues Int?

  // Last production deployment on Vercel — sync-owned, from the project's
  // production target. Null until it has shipped to prod at least once.
  lastDeployedAt DateTime?

  // -- Counts (denormalised for fast grid rendering) --------------
  envVarCount  Int @default(0)
  domainCount  Int @default(0)
  databaseCount Int @default(0)

  // -- Capabilities: auto-detected, manually overridable -----------
  sendsEmailAuto      Boolean  @default(false)
  sendsEmailOverride  Boolean?
  usesSharePointAuto     Boolean  @default(false)
  usesSharePointOverride Boolean?
  externalDataAuto       Boolean  @default(false)
  externalDataOverride   Boolean?

  // -- Manual assignment ------------------------------------------
  stage         ProjectStage @default(DEVELOPMENT)
  clientId      String?
  client        Organization? @relation("ProjectClient", fields: [clientId], references: [id], onDelete: SetNull)
  endCustomerId String?
  endCustomer   Organization? @relation("ProjectEndCustomer", fields: [endCustomerId], references: [id], onDelete: SetNull)
  notes         String?

  // Hide from the grid without deleting (e.g. throwaway experiments).
  hidden Boolean @default(false)

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  envVars     ProjectEnvVar[]
  domains     ProjectDomain[]
  databases   ProjectDatabase[]
  connections ExternalConnection[]
  signals     DetectionSignal[]
  noteEntries ProjectNote[]
  costLines   CostLine[]
  vendorLinks VendorProjectLink[]

  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([gitOwner, gitRepo])
  @@index([clientId])
  @@index([endCustomerId])
  @@index([stage])
}

// Env var KEYS only — values are never fetched or stored.
model ProjectEnvVar {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key       String
  targets   String[] // production | preview | development
  isSensitive Boolean @default(false)

  @@unique([projectId, key])
  @@index([projectId])
}

model ProjectDomain {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  domain    String
  verified  Boolean @default(false)
  isVercelDomain Boolean @default(false) // *.vercel.app vs a real custom domain
  redirectTo     String?

  @@unique([projectId, domain])
  @@index([projectId])
}

model ProjectDatabase {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      StoreKind
  provider  String? // Neon | Upstash | Vercel Blob | Supabase ...
  name      String
  storeId   String?
  // How we know about it — a linked Vercel store, or inferred from an env key.
  inferred  Boolean   @default(false)

  @@unique([projectId, name])
  @@index([projectId])
}

// "Connects directly to external data?" — click to reveal these.
model ExternalConnection {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label     String // "MS SQL Server", "SAP", "Perigee API"
  detail    String?
  inferred  Boolean @default(false)

  @@index([projectId])
}

// The evidence trail behind an auto-detected capability flag, so a surprising
// tick in the grid can be explained rather than second-guessed.
model DetectionSignal {
  id         String       @id @default(cuid())
  projectId  String
  project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  capability Capability
  source     SignalSource
  evidence   String // "RESEND_API_KEY", "@microsoft/microsoft-graph-client"

  @@unique([projectId, capability, evidence])
  @@index([projectId])
}

// A timestamped note log on a project — distinct from the single free-text
// `Project.notes` field. Every entry records who wrote it (Carl by hand, or the
// assistant on his behalf) and exactly when, so the history reads back like a
// running journal. Never touched by the sync.
model ProjectNote {
  id        String     @id @default(cuid())
  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  body      String
  author    NoteAuthor @default(CARL)
  createdAt DateTime   @default(now())

  @@index([projectId])
}

// ---------------------------------------------------------------- billing
//
// The chain is: CostLine (what a vendor charged) → rollup → what a client owes.
//
//  * Every cost is stored in USD, because that is the currency every vendor
//    actually bills in. ZAR is derived at display time from the ONE rate stored
//    on the period, so re-opening a March invoice in July shows March's rand.
//  * Nothing downstream is persisted. Project totals, client totals, markup and
//    the ZAR figures are all computed from these tables by src/lib/billing/
//    rollup.ts on every read. A saved artefact would go stale the moment an
//    allocation or a rate was corrected.
//  * Closing a period freezes the inputs instead (rate + ClientPeriodTerms), so
//    a historical invoice cannot move under you while an open one stays live.

// One calendar month of billing. Costs land in the period their charge date
// falls in, not the period they were ingested in.
model BillingPeriod {
  id    String @id @default(cuid())
  year  Int
  month Int // 1-12
  label String @unique // "2026-08" — the human-facing key, and how URLs address it

  // USD → ZAR for this month, locked once entered. Null means the period has no
  // rate yet and the UI must show USD only rather than guess.
  usdToZar   Decimal? @db.Decimal(14, 6)
  rateSource String? // "manual" | "frankfurter.app"
  rateSetAt  DateTime?

  // A closed period is read-only: no re-ingest, no allocation edits, and the
  // markup of every client has been materialised into ClientPeriodTerms.
  closed   Boolean   @default(false)
  closedAt DateTime?

  costLines   CostLine[]
  allocations SharedCostAllocation[]
  terms       ClientPeriodTerms[]
  ingestRuns  CostIngestRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, month])
  @@index([year, month])
}

// A single charge from a third party.
model CostLine {
  id       String        @id @default(cuid())
  periodId String
  period   BillingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  vendor      Vendor
  vendorLabel String? // only for OTHER — e.g. "Twilio"
  kind        CostKind

  // Set for METERED, always null for BASE_FEE. Null on a METERED line means the
  // vendor reported usage we could not tie to a project — the UI surfaces those
  // loudly rather than quietly dropping them into the shared bucket.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // When a METERED line arrives with an identity we could not resolve, the
  // identity is kept here rather than discarded. That is what lets the billing
  // page say "$47 of Claude spend is in workspace wrkspc_01ABC — map it" and
  // offer to fix it, instead of showing an unexplained shortfall.
  unresolvedKey   String?
  unresolvedLabel String?

  // What was bought: "Fluid Compute", "Actions Linux", "claude-opus-5", "Emails".
  service  String
  quantity Decimal? @db.Decimal(24, 6)
  unit     String? // "minutes" | "GB-hours" | "tokens" | "emails" | "requests"

  // Always USD. Zero is a real value (a free-tier line still proves usage).
  costUsd Decimal @db.Decimal(16, 6)

  // Provenance. `source` names the collector, `externalRef` the vendor's own id
  // for the row, and `raw` keeps the original payload so a surprising number can
  // be explained without re-querying an API whose window may have moved on.
  source      String
  externalRef String?
  raw         Json?

  chargedOn  DateTime // the day the vendor dated the charge
  ingestedAt DateTime @default(now())

  // Deterministic per (period, vendor, project, service, day, ref). Re-running
  // an ingest overwrites rather than duplicating — the collectors are re-run
  // daily for the open month, so append-only would multiply every figure.
  dedupeKey String

  @@unique([periodId, dedupeKey])
  @@index([periodId, vendor])
  @@index([projectId])
  @@index([periodId, kind])
}

// How a vendor's BASE_FEE for one period is divided between clients.
//
// Deliberately manual and deliberately per-CLIENT. Carl carries context about
// who is getting value out of a seat that no formula in this codebase has —
// so the split is an input, not a calculation. Shares that don't reach 100%
// are not an error: the remainder is absorbed by the business, and the UI says
// so out loud.
model SharedCostAllocation {
  id       String        @id @default(cuid())
  periodId String
  period   BillingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  vendor   Vendor
  clientId String
  client   Organization @relation(fields: [clientId], references: [id], onDelete: Cascade)

  shareBasisPoints Int // 0-10000; 2500 = a quarter of that vendor's base fees
  note             String?

  updatedAt DateTime @updatedAt

  @@unique([periodId, vendor, clientId])
  @@index([periodId])
}

// The markup that applied to a client in a given period. Written lazily on
// close so that changing a client's rate today cannot rewrite an invoice you
// have already sent.
model ClientPeriodTerms {
  id       String        @id @default(cuid())
  periodId String
  period   BillingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  clientId String
  client   Organization  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  markupBasisPoints Int

  @@unique([periodId, clientId])
}

// Maps a vendor's own identity for a project onto ours.
//
// Vercel and GitHub don't need this — their billing data already names the
// project and the repo. Anthropic reports by workspace or API key, Resend by
// sending domain, Google by GCP project: all opaque strings that only Carl can
// tie to a project, and without which their spend cannot be attributed at all.
model VendorProjectLink {
  id            String  @id @default(cuid())
  vendor        Vendor
  externalId    String // workspace id, api key id, sending domain, GCP project id
  externalLabel String? // what the vendor calls it, for the picker
  projectId     String
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([vendor, externalId])
  @@index([projectId])
}

// Single-row config. Keyed by a fixed id so there can only ever be one.
model BillingSettings {
  id String @id @default("singleton")

  // House markup for any client without its own rate. 1500 = 15%.
  defaultMarkupBasisPoints Int @default(1500)

  // Resend bills a plan fee, not per-email, so an email has no intrinsic cost.
  // Set a rate here to price sends as metered usage; leave at 0 to treat Resend
  // as a pure base fee and let the per-client allocation carry it.
  resendUsdPerEmail Decimal @default(0) @db.Decimal(12, 8)

  // Currency shown alongside USD on invoices.
  billingCurrency String @default("ZAR")

  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------- ops

// One vendor's collection attempt for one period. Written even when nothing
// comes back: a collector that silently returns zero rows and a collector that
// was never called look identical on a dashboard, and only one of them is fine.
model CostIngestRun {
  id       String        @id @default(cuid())
  periodId String
  period   BillingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  vendor       Vendor
  status       IngestStatus @default(RUNNING)
  startedAt    DateTime     @default(now())
  finishedAt   DateTime?
  linesWritten Int          @default(0)
  linesRemoved Int          @default(0)
  costUsdTotal Decimal      @default(0) @db.Decimal(16, 6)
  unmapped     Int          @default(0) // rows the vendor gave us that we could not attribute
  error        String?
  log          String?

  @@index([periodId, vendor])
  @@index([startedAt])
}

model SyncRun {
  id          String     @id @default(cuid())
  status      SyncStatus @default(RUNNING)
  startedAt   DateTime   @default(now())
  finishedAt  DateTime?
  projectsSeen Int       @default(0)
  projectsCreated Int    @default(0)
  projectsUpdated Int    @default(0)
  error       String?
  log         String?
}

// ---------------------------------------------------------------- auth (dormant)

model User {
  id          String  @id @default(cuid())
  email       String? @unique
  name        String?
  avatarUrl   String?
  githubLogin String? @unique
  isAdmin     Boolean @default(false)

  // Teammates connect their own Vercel token so the sync can see their scopes.
  vercelTokenEnc String?

  projects      Project[]
  organizations Organization[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
